<!DOCTYPE html>
<html lang="en">
  <head>
    <%- include('partials/MetaHead.ejs') %>
    <title>Edit Book</title>
  </head>
  <body>
    <%- include("partials/Navigation") %>

    <main class="main-form">
      <form class="form" action="/update/<%= book.id %>" method="POST">
        <div class="form__group form__group--small">
          <h2 class="form__title">EDIT BOOK</h2>
        </div>
        <div class="form__group">
          <label class="form__label" for="title">TITLE</label>
          <input
            class="form__input"
            type="text"
            name="title"
            id="title"
            value="<%= book.title %>"
          />
          <span></span>
        </div>
        <div class="form__group">
          <label class="form__label" for="author">AUTHOR</label>
          <input 
          class="form__input"
          type="text" 
          name="author" 
          id="author"
          value="<%= book.author %>" />
          <span></span>
        </div>
        <div class="form__group">
          <label class="form__label" for="image">IMAGE (URL)</label>
          <input class="form__input"
          type="text"
          name="image" 
          id="image" 
          placeholder="http(s)://website.com" 
          value="<%= book.image %>"/>
          <span></span>
        </div>
        <div class="form__group">
          <button class="form__submit" type="submit">SAVE</button>
        </div>
      </form>
    </main>
    <%- include("partials/Footer") %>

    <script src="/js/validate-form.js"></script>
  </body>
</html>
