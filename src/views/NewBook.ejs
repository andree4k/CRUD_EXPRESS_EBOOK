<!DOCTYPE html>
<html lang="en">
  <head>
    <%- include('partials/MetaHead.ejs') %>
    <title>New Book</title>
  </head>
  <body>
    <%- include("partials/Navigation") %>
    <main class="main-form">
      <form class="form" action="/newBook" method="POST">
        <div class="form__group form__group--small">
          <h2 class="form__title">ADD NEW BOOK</h2>
        </div>
        <div class="form__group">
          <label class="form__label" for="title">TITLE</label>
          <input
            class="form__input"
            type="text"
            name="title"
            id="title"
            autofocus
          />
          <span></span>
        </div>
        <div class="form__group">
          <label class="form__label" for="author">AUTHOR</label>
          <input 
          class="form__input"
          type="text" 
          name="author" 
          id="author" />
          <span></span>
        </div>
        <div class="form__group">
          <label class="form__label" for="image">IMAGE (URL)</label>
          <input class="form__input"
          type="text"
          name="image" 
          id="image"
          placeholder="http(s)://website.com" />
          <span></span>
        </div>
        <div class="form__group">
          <button class="form__submit" type="submit">ADD BOOK</button>
        </div>
      </form>
    </main>

    <%- include("partials/Footer") %>

    <script src="/js/validate-form.js"></script>
  </body>
</html>
